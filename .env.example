# --- Zorunlu ---------------------------------------------------------------
# Neon PostgreSQL bağlantı adresi.
DATABASE_URL=postgresql://kullanici:sifre@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# --- Ortam -----------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false

# --- CORS ------------------------------------------------------------------
# Frontend adresleri, virgülle ayrılır. Üretimde "*" KULLANMAYIN.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173
# Vercel preview deployment'ları için regex.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Veritabanı havuzu (opsiyonel) -----------------------------------------
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=300
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=15000
# Serverless (Vercel) ortamında otomatik açılır.
# DB_USE_NULL_POOL=true

# --- Davranış (opsiyonel) --------------------------------------------------
# Eksik tabloları açılışta oluştur. Üretimde false + scripts/migrate.py önerilir.
AUTO_CREATE_TABLES=true
# Bu süreden uzun süren "running" kayıtlar "stalled" sayılır.
ACTIVITY_STALE_AFTER_MINUTES=10
DASHBOARD_ACTIVITY_LIMIT=10

# --- Üçüncü parti servisler ------------------------------------------------
FIRECRAWL_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Step 13: karar verici araması. Yoksa nitelikli şirketlerde bu adım atlanır.
APOLLO_API_KEY=
# Şirket başına kaydedilecek azami karar verici.
APOLLO_MAX_CONTACTS=8

# --- Workflow 3: web sitesi araştırması (opsiyonel) ------------------------
# Taranacak azami sayfa sayısı (20) spec gereği koda sabitlenmiştir; buradan
# yükseltilemez. Aşağıdakiler yalnızca keşif ve token bütçesini ayarlar.
# `map` ile listelenecek azami aday URL sayısı (tarama değil, sadece liste).
RESEARCH_MAP_LIMIT=300
# Analyzer'a gönderilen sayfa başına ve toplam karakter bütçesi.
RESEARCH_CHARS_PER_PAGE=2500
RESEARCH_TOTAL_CHARS=30000
# Batch taramanın tamamlanması için beklenecek azami süre (saniye).
RESEARCH_SCRAPE_TIMEOUT=180
# n8n toplu keşifte şirketler sırayla işlenir; her şirket arasında bu kadar
# saniye beklenir (Firecrawl / OpenAI / Apollo rate limit).
RESEARCH_JOB_GAP_SECONDS=5
